{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        "strict": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "declaration": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist", "tests"]
}
